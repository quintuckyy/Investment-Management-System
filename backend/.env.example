# Copy this file to backend/.env and fill in your values.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True

# Comma-separated hosts the API may be served on, and browser origins allowed to call it.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection (PostgreSQL's default port is 5432)
DB_NAME=investment_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Maximum login attempts per minute per client
LOGIN_THROTTLE_RATE=20/min
